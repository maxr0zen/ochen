{
  "name": "vector-composer",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "register": "node scripts/register.mjs",
    "dev": "node scripts/serve.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:ui": "playwright test",
    "check": "npm run typecheck && npm test && npm run build",
    "ai:setup": "node scripts/ai-setup.mjs",
    "ai": "node --experimental-strip-types server/ai-server.ts",
    "ai:check": "node --experimental-strip-types scripts/ai-check.ts",
    "demo:build": "node scripts/build-demo.mjs",
    "demo:check": "node scripts/build-demo.mjs && node scripts/verify-demo-standalone.mjs"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.117.0",
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "fflate": "^0.8.3"
  }
}
